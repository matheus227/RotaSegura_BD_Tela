<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.concessionaria.gui.VeiculosController"
      spacing="16.0" styleClass="tela">
    <VBox minWidth="330.0" prefWidth="330.0" spacing="6.0" styleClass="painel">
        <Label fx:id="lblModo" styleClass="titulo-painel" text="Novo veículo" />
        <Label text="Categoria *" />
        <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" />
        <Label fx:id="lblRegras" styleClass="texto-suave" wrapText="true" />
        <Label text="Placa *" />
        <TextField fx:id="txtPlaca" promptText="ABC1D23 ou ABC-1234" />
        <Label text="Marca *" />
        <TextField fx:id="txtMarca" promptText="Ex.: Fiat" />
        <Label text="Modelo *" />
        <TextField fx:id="txtModelo" promptText="Ex.: Argo" />
        <Label text="Ano *" />
        <TextField fx:id="txtAno" promptText="Ex.: 2024" />
        <Label text="Diária (R$) *" />
        <TextField fx:id="txtDiaria" promptText="Ex.: 129,90" />
        <HBox spacing="8.0" styleClass="barra-botoes">
            <Button fx:id="btnSalvar" onAction="#onSalvar" styleClass="botao-primario" text="Salvar" />
            <Button onAction="#onNovo" text="Novo" />
            <Button fx:id="btnExcluir" onAction="#onExcluir" styleClass="botao-perigo" text="Excluir" />
        </HBox>
    </VBox>
    <VBox spacing="8.0" styleClass="painel" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Buscar:" />
            <TextField fx:id="txtBusca" promptText="Placa, marca ou modelo" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cmbFiltroCategoria" prefWidth="140.0" promptText="Categoria" />
            <Button onAction="#onLimparFiltros" text="Limpar" />
        </HBox>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="Nº" />
                <TableColumn fx:id="colPlaca" prefWidth="90.0" text="Placa" />
                <TableColumn fx:id="colMarca" prefWidth="110.0" text="Marca" />
                <TableColumn fx:id="colModelo" prefWidth="130.0" text="Modelo" />
                <TableColumn fx:id="colAno" prefWidth="60.0" text="Ano" />
                <TableColumn fx:id="colCategoria" prefWidth="90.0" text="Categoria" />
                <TableColumn fx:id="colDiaria" prefWidth="100.0" text="Diária" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</HBox>
